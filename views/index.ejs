<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <title>AI Soud Shazamské republiky</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen">
    <header class="bg-slate-800 border-b border-slate-700 py-6 shadow-lg">
        <div class="container mx-auto px-6 flex justify-between items-center">
            <div>
                <h1 class="text-3xl font-bold tracking-wider text-emerald-400">⚖️ AI SOUD SHAZAMSKÉ REPUBLIKY</h1>
                <p class="text-sm text-slate-400 mt-1">Plně automatizovaný justiční systém (Node.js) s reálnými AI zaměstnanci a SMS bránou Odorik</p>
            </div>
            <div class="bg-slate-700 px-4 py-2 rounded-lg text-sm border border-slate-600">
                <span class="inline-block w-3 h-3 bg-emerald-500 rounded-full animate-pulse mr-2"></span>
                Systém aktivní &nbsp;|&nbsp; Zákonné lhůty vynucovány
            </div>
        </div>
    </header>

    <main class="container mx-auto px-6 py-8 grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="bg-slate-800 p-6 rounded-xl border border-slate-700 shadow-xl lg:col-span-1">
            <h2 class="text-xl font-semibold mb-4 text-emerald-300 border-b border-slate-700 pb-2">📋 Podat novou žádost</h2>
            <form action="/create_case" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Oddělení soudu</label>
                    <select name="department" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-slate-200 focus:border-emerald-500 focus:outline-none">
                        <option value="OSPOD">1. OSPOD (Ochrana dětí a sociální péče)</option>
                        <option value="Matrika">2. Matriční oddělení (Svatby a partnerství)</option>
                        <option value="Rozvody">3. Úsek rozvodů (Rozvody a SJM)</option>
                        <option value="Arbitráž">4. Arbitráž vztahů (Rozchody a složité vztahy 2-3+ lidí)</option>
                    </select>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Navrhovatel (Jméno)</label>
                        <input type="text" name="applicant_name" required placeholder="Jan Novák" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-slate-200 focus:border-emerald-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Tel. navrhovatele</label>
                        <input type="text" name="applicant_phone" placeholder="+420603123456" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-slate-200 focus:border-emerald-500 focus:outline-none">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Druhý účastník (Manžel/ka)</label>
                        <input type="text" name="spouse_name" placeholder="Jana Nováková" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-slate-200 focus:border-emerald-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Tel. druhého účastníka</label>
                        <input type="text" name="spouse_phone" placeholder="+420603654321" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-slate-200 focus:border-emerald-500 focus:outline-none">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Ostatní dotčené osoby (děti, milenci...)</label>
                    <input type="text" name="other_parties" placeholder="např. syn Petr (12 let)" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-slate-200 focus:border-emerald-500 focus:outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Podrobný popis situace a požadavků</label>
                    <textarea name="description" rows="4" required placeholder="Popište důvody, neshody, majetek, péči o děti..." class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-slate-200 focus:border-emerald-500 focus:outline-none"></textarea>
                </div>
                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 font-semibold py-3 rounded-lg transition shadow-lg text-white">
                    🏛️ Podat žádost k soudu
                </button>
            </form>

            <form action="/admin/reset" method="POST" class="mt-4" onsubmit="return confirm('Opravdu smazat VŠECHNY spisy a SMS logy?');">
                <button type="submit" class="w-full bg-red-700 hover:bg-red-600 font-semibold py-2 rounded-lg transition shadow text-white text-sm">
                    🗑️ Smazat všechny spisy a řízení
                </button>
            </form>

            <div class="mt-8">
                <h3 class="text-lg font-semibold mb-3 text-emerald-300 border-b border-slate-700 pb-2">👥 AI Zaměstnanci soudu</h3>
                <div class="space-y-3">
                    <% staff.forEach(function(s){ %>
                    <div class="bg-slate-900 p-3 rounded-lg border border-slate-700 text-xs">
                        <div class="font-bold text-emerald-400"><%= s.name %></div>
                        <div class="text-slate-300 font-semibold"><%= s.role %> <span class="text-slate-500">(<%= s.department %>)</span></div>
                        <div class="text-slate-400 italic mt-1"><%= s.personality %></div>
                    </div>
                    <% }) %>
                </div>
            </div>
        </div>

        <div class="bg-slate-800 p-6 rounded-xl border border-slate-700 shadow-xl lg:col-span-2">
            <h2 class="text-xl font-semibold mb-4 text-emerald-300 border-b border-slate-700 pb-2">📁 Soudní spisy a řízení</h2>
            <% if (!cases || cases.length === 0) { %>
            <div class="text-center py-12 text-slate-500">Zatím neevidujeme žádné soudní žádosti. Vytvořte první žádost v levém formuláři.</div>
            <% } else { %>
            <div class="space-y-4">
                <% cases.forEach(function(c){ %>
                <div class="bg-slate-900 border border-slate-700 rounded-xl p-4 hover:border-emerald-500 transition">
                    <div class="flex justify-between items-start">
                        <div>
                            <span class="bg-emerald-900 text-emerald-300 text-xs font-bold px-2.5 py-1 rounded border border-emerald-700"><%= c.case_number %></span>
                            <span class="ml-2 text-xs bg-slate-800 text-slate-300 px-2.5 py-1 rounded border border-slate-700"><%= c.department %></span>
                            <h3 class="text-lg font-bold mt-2 text-white"><%= c.applicant_name %> vs. <%= c.spouse_name %></h3>
                        </div>
                        <div class="text-right">
                            <span class="text-xs font-semibold px-3 py-1 rounded-full <%= c.status.indexOf('Ukončeno') === 0 ? 'bg-blue-900 text-blue-300 border border-blue-700' : 'bg-amber-900 text-amber-300 border border-amber-700 animate-pulse' %>">
                                <%= c.status %>
                            </span>
                            <div class="text-xs text-slate-400 mt-2">Soudce: <%= c.judge_name %></div>
                        </div>
                    </div>
                    <div class="mt-4 flex justify-between items-center text-xs text-slate-400 border-t border-slate-800 pt-3">
                        <div>Zahájeno: <%= c.created_at.substring(0,16).replace('T',' ') %> | Zákonná lhůta do: <%= c.deadline_at.substring(0,16).replace('T',' ') %></div>
                        <a href="/case/<%= c.id %>" class="bg-slate-800 hover:bg-emerald-600 text-slate-200 hover:text-white px-3 py-1.5 rounded-lg border border-slate-700 transition">Prozkoumat spis &rarr;</a>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } %>

            <div class="mt-10">
                <h3 class="text-lg font-semibold mb-3 text-emerald-300 border-b border-slate-700 pb-2">📱 Odorik SMS brána - Poslední zprávy</h3>
                <div class="bg-slate-900 rounded-xl border border-slate-700 overflow-hidden text-xs">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-800 text-slate-400 border-b border-slate-700">
                                <th class="p-3">Čas</th><th class="p-3">Spis</th><th class="p-3">Příjemce</th><th class="p-3">Zpráva</th><th class="p-3">Stav</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!smsLogs || smsLogs.length === 0) { %>
                            <tr><td colspan="5" class="p-4 text-center text-slate-500">Žádné odeslané SMS zprávy.</td></tr>
                            <% } else { smsLogs.forEach(function(l){ %>
                            <tr class="border-b border-slate-800 hover:bg-slate-800/50">
                                <td class="p-3 text-slate-400"><%= l.sent_at.substring(0,16).replace('T',' ') %></td>
                                <td class="p-3 font-semibold text-emerald-400"><%= l.case_number %></td>
                                <td class="p-3"><%= l.recipient_name %><br><span class="text-slate-500"><%= l.recipient_phone %></span></td>
                                <td class="p-3 text-slate-300 italic"><%= l.message %></td>
                                <td class="p-3"><span class="px-2 py-0.5 rounded text-[10px] <%= (l.status.indexOf('SENT')>=0 || l.status.indexOf('SIMULATED')>=0) ? 'bg-emerald-900 text-emerald-300' : 'bg-red-900 text-red-300' %>"><%= l.status %></span></td>
                            </tr>
                            <% }) } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
