<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <title>Detail spisu <%= c.case_number %> - AI Soud</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen">
    <header class="bg-slate-800 border-b border-slate-700 py-6 shadow-lg">
        <div class="container mx-auto px-6 flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-bold text-emerald-400">⚖️ Detail soudního spisu: <%= c.case_number %></h1>
                <p class="text-sm text-slate-400 mt-1">Oddělení: <%= c.department %> | Soudce/Úředník: <%= c.judge_name %></p>
            </div>
            <a href="/" class="bg-slate-700 hover:bg-slate-600 text-slate-200 px-4 py-2 rounded-lg text-sm border border-slate-600 transition">&larr; Zpět na přehled soudu</a>
        </div>
    </header>
    <main class="container mx-auto px-6 py-8 grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="bg-slate-800 p-6 rounded-xl border border-slate-700 shadow-xl lg:col-span-1 space-y-6">
            <div>
                <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Stav řízení</h3>
                <p class="text-lg font-bold text-amber-400 mt-1"><%= c.status %></p>
            </div>
            <div class="border-t border-slate-700 pt-4">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Účastníci řízení</h3>
                <div class="mt-2 space-y-2 text-sm">
                    <div class="bg-slate-900 p-3 rounded-lg border border-slate-700">
                        <div class="text-xs text-slate-400 font-semibold uppercase">Navrhovatel</div>
                        <div class="font-bold text-emerald-300"><%= c.applicant_name %></div>
                        <div class="text-xs text-slate-400">Tel: <%= c.applicant_phone || 'neuvedeno' %></div>
                    </div>
                    <div class="bg-slate-900 p-3 rounded-lg border border-slate-700">
                        <div class="text-xs text-slate-400 font-semibold uppercase">Druhý účastník</div>
                        <div class="font-bold text-emerald-300"><%= c.spouse_name %></div>
                        <div class="text-xs text-slate-400">Tel: <%= c.spouse_phone || 'neuvedeno' %></div>
                    </div>
                    <% if (c.other_parties) { %>
                    <div class="bg-slate-900 p-3 rounded-lg border border-slate-700">
                        <div class="text-xs text-slate-400 font-semibold uppercase">Ostatní dotčené osoby</div>
                        <div class="text-slate-200"><%= c.other_parties %></div>
                    </div>
                    <% } %>
                </div>
            </div>
            <div class="border-t border-slate-700 pt-4 text-xs text-slate-400 space-y-1">
                <div>Zahájeno: <%= c.created_at.substring(0,16).replace('T',' ') %></div>
                <div>Zákonná lhůta (konečný termín): <span class="text-white font-semibold"><%= c.deadline_at.substring(0,16).replace('T',' ') %></span></div>
                <div>Automatické vyřešení (demo): <%= c.resolve_at.substring(0,16).replace('T',' ') %></div>
            </div>
        </div>
        <div class="bg-slate-800 p-6 rounded-xl border border-slate-700 shadow-xl lg:col-span-2 space-y-6">
            <div>
                <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Původní podání / Žádost</h3>
                <div class="bg-slate-900 p-4 rounded-xl border border-slate-700 text-slate-300 text-sm italic">"<%= c.description %>"</div>
            </div>
            <div>
                <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Výsledky vyšetřování a soudní verdikt</h3>
                <div class="bg-slate-900 p-4 rounded-xl border border-slate-700 text-slate-200 text-sm whitespace-pre-line leading-relaxed"><%= c.verdict %></div>
                <% if (c.status.indexOf('Ukončeno') === 0) { %>
                <div class="mt-3 flex gap-2">
                    <a href="/case/<%= c.id %>/pdf" class="inline-block bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-lg text-sm font-semibold transition">📄 Stáhnout rozhodnutí (PDF)</a>
                </div>
                <% } else { %>
                <div class="mt-3">
                    <form action="/resolve/<%= c.id %>" method="POST" class="inline">
                        <button type="submit" class="bg-amber-600 hover:bg-amber-500 text-white px-4 py-2 rounded-lg text-sm font-semibold transition">⚡ Vynutit vyřešení (test)</button>
                    </form>
                    <span class="text-xs text-slate-500 ml-2">Pro produkci se řízení vyřeší automaticky po uplynutí lhůty.</span>
                </div>
                <% } %>
            </div>
            <div>
                <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Odeslané Odorik SMS zprávy v tomto spisu</h3>
                <div class="bg-slate-900 rounded-xl border border-slate-700 overflow-hidden text-xs">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-800 text-slate-400 border-b border-slate-700">
                                <th class="p-2.5">Čas</th><th class="p-2.5">Příjemce</th><th class="p-2.5">Zpráva</th><th class="p-2.5">Stav</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!logs || logs.length === 0) { %>
                            <tr><td colspan="4" class="p-4 text-center text-slate-500">Žádné SMS zprávy.</td></tr>
                            <% } else { logs.forEach(function(l){ %>
                            <tr class="border-b border-slate-800">
                                <td class="p-2.5 text-slate-400"><%= l.sent_at.substring(0,16).replace('T',' ') %></td>
                                <td class="p-2.5"><%= l.recipient_name %><br><span class="text-slate-500"><%= l.recipient_phone %></span></td>
                                <td class="p-2.5 text-slate-300 italic"><%= l.message %></td>
                                <td class="p-2.5"><span class="px-2 py-0.5 rounded text-[10px] bg-emerald-900 text-emerald-300"><%= l.status %></span></td>
                            </tr>
                            <% }) } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
