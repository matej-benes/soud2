# === Databáze (vyber jednu) ===
# Vercel Postgres (Neon) - nejjednodušší na Vercelu (Storage -> Create Database -> Postgres)
# POSTGRES_URL=postgres://...
# nebo DATABASE_URL / NEON_DATABASE_URL

# Turso (libSQL) - free tier, turso.tech
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=eyJ...

# Bez těchto proměnných se použije /tmp JSON (data se po restartu ztratí)

# === Odorik SMS brána (volitelné) ===
ODORIK_API_USER=
ODORIK_API_PASSWORD=

# === OpenAI (volitelné) ===
OPENAI_API_KEY=

# === Lhůty ===
LEGAL_DEADLINE_DAYS=30
# RESOLVE_DELAY_SECONDS=60
EOF